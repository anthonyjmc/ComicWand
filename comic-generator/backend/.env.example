## Backend environment configuration for Comic Generator
DATABASE_URL=postgresql+asyncpg://comic_user:comic_password@localhost:5432/comic_generator
REDIS_URL=redis://localhost:6379/0
REPLICATE_API_TOKEN=your_replicate_api_token
ANTHROPIC_API_KEY=your_anthropic_api_key
CLOUDFLARE_R2_BUCKET=comic-generator-assets
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
CLERK_ISSUER=https://your-clerk-issuer
CLERK_AUDIENCE=your-clerk-audience
EXTERNAL_ASSET_ALLOWED_HOSTS=replicate.delivery,r2.cloudflarestorage.com
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
ENVIRONMENT=development
MAX_PAGES_PER_COMIC=48
MAX_COMICS_PER_DAY=5
MAX_FILE_SIZE_MB=10
